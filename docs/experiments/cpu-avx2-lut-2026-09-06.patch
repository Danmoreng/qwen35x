+void run_lut_projection(void *ctx, std::size_t begin, std::size_t end) noexcept {
+  auto &j=*static_cast<LutProjectionJob*>(ctx);
+  if(j.output) {
+    cpu::lut_q4_matvec(j.weights+begin*j.blocks,j.input,j.output+begin*8,(end-begin)*8,j.blocks);
+  } else {
+    std::size_t p=0;
+    for(;p+1<j.partitions;++p)
