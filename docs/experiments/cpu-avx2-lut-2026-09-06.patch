diff --git a/include/qwen35x/cpu/lut_q4.h b/include/qwen35x/cpu/lut_q4.h
new file mode 100644
--- /dev/null
+++ b/include/qwen35x/cpu/lut_q4.h
@@ -0,0 +1,11 @@
+#pragma once
+#include "qwen35x/cpu/q4_0.h"
+namespace qwen35x::cpu {
+// Experimental offline bit-plane representation; same 144-byte payload as DOT4.
+struct LutQ4Block { std::uint16_t d[8]; std::uint8_t masks[8][4][4]; };
+struct alignas(32) LutQ8Block { std::uint8_t lo[8][16], hi[8][16]; float scale; int sum; };
+void lut_q4_pack(const Q4_0BlockX8*, LutQ4Block*, std::size_t) noexcept;
+void lut_q8_prepare(const Q8_0BlockX1*, LutQ8Block*, std::size_t) noexcept;
+void lut_q4_matvec(const LutQ4Block*, const LutQ8Block*, float*, std::size_t, std::size_t) noexcept;
+Q4_0ArgmaxResult lut_q4_argmax(const LutQ4Block*, const LutQ8Block*, const int*, float, std::size_t, std::size_t, std::size_t) noexcept;
+}
diff --git a/src/cpu/lut_q4_avx2.cpp b/src/cpu/lut_q4_avx2.cpp
new file mode 100644
--- /dev/null
+++ b/src/cpu/lut_q4_avx2.cpp
@@ -0,0 +1,77 @@
+#include "qwen35x/cpu/lut_q4.h"
+#include <immintrin.h>
+#include <cstring>
+#include <limits>
+namespace qwen35x::cpu {
+static_assert(sizeof(LutQ4Block)==sizeof(Q4_0BlockX8));
+void lut_q4_pack(const Q4_0BlockX8 *src,LutQ4Block *dst,std::size_t blocks) noexcept {
+ for(std::size_t b=0;b<blocks;++b) {
+  dst[b]={}; std::memcpy(dst[b].d,src[b].d,sizeof(dst[b].d));
+  for(int g=0;g<8;++g) for(int bit=0;bit<4;++bit) for(int r=0;r<8;++r) {
+   int mask=0;
+   for(int j=0;j<4;++j) {
+    int k=g*4+j;
+    int u=(src[b].qs[32*(k/8)+4*r+k%4]>>(4*((k%8)/4)))&15;
+    mask|=((u>>bit)&1)<<j;
+   }
+   dst[b].masks[g][bit][r%4]|=static_cast<std::uint8_t>(mask<<(4*(r/4)));
+  }
+ }
+}
+void lut_q8_prepare(const Q8_0BlockX1 *src,LutQ8Block *dst,std::size_t blocks) noexcept {
+ for(std::size_t b=0;b<blocks;++b) {
+  dst[b].scale=src[b].scales[0]; dst[b].sum=src[b].sums[0];
+  for(int g=0;g<8;++g) for(int mask=0;mask<16;++mask) {
+   int sum=0;
+   for(int j=0;j<4;++j) if(mask&(1<<j)) sum+=src[b].qs[4*g+j];
+   auto bits=static_cast<std::uint16_t>(sum);
+   dst[b].lo[g][mask]=static_cast<std::uint8_t>(bits);
+   dst[b].hi[g][mask]=static_cast<std::uint8_t>(bits>>8);
+  }
+ }
+}
+static inline __m128i lookup(const std::uint8_t *masks,__m128i lo,__m128i hi) noexcept {
+ int bytes; std::memcpy(&bytes,masks,4);
+ auto raw=_mm_cvtsi32_si128(bytes);
+ auto mask=_mm_set1_epi8(15);
+ auto indices=_mm_unpacklo_epi32(_mm_and_si128(raw,mask),_mm_and_si128(_mm_srli_epi16(raw,4),mask));
+ return _mm_unpacklo_epi8(_mm_shuffle_epi8(lo,indices),_mm_shuffle_epi8(hi,indices));
+}
+static inline __m256 eval(const LutQ4Block *w,const LutQ8Block *a,std::size_t blocks) noexcept {
+ auto acc=_mm256_setzero_ps();
+ for(std::size_t b=0;b<blocks;++b) {
+  auto first=_mm_setzero_si128(),second=_mm_setzero_si128();
+  for(int g=0;g<8;++g) {
+   auto lo=_mm_loadu_si128(reinterpret_cast<const __m128i*>(a[b].lo[g]));
+   auto hi=_mm_loadu_si128(reinterpret_cast<const __m128i*>(a[b].hi[g]));
+   auto x0=lookup(w[b].masks[g][0],lo,hi);
+   auto x1=_mm_slli_epi16(lookup(w[b].masks[g][1],lo,hi),1);
+   auto x2=_mm_slli_epi16(lookup(w[b].masks[g][2],lo,hi),2);
+   auto x3=_mm_slli_epi16(lookup(w[b].masks[g][3],lo,hi),3);
+   auto sum=_mm_add_epi16(_mm_add_epi16(x0,x1),_mm_add_epi16(x2,x3));
+   // Four groups contain 16 products, bounded by 16*15*128=30720.
+   if(g<4)first=_mm_add_epi16(first,sum);else second=_mm_add_epi16(second,sum);
+  }
+  auto dot=_mm256_sub_epi32(_mm256_add_epi32(_mm256_cvtepi16_epi32(first),_mm256_cvtepi16_epi32(second)),_mm256_set1_epi32(8*a[b].sum));
+  auto scale=_mm256_mul_ps(_mm256_cvtph_ps(_mm_loadu_si128(reinterpret_cast<const __m128i*>(w[b].d))),_mm256_set1_ps(a[b].scale));
+  acc=_mm256_fmadd_ps(_mm256_cvtepi32_ps(dot),scale,acc);
+ }
+ return acc;
+}
+void lut_q4_matvec(const LutQ4Block*w,const LutQ8Block*a,float*out,std::size_t rows,std::size_t blocks) noexcept {
+ for(std::size_t r=0;r<rows/8;++r)_mm256_storeu_ps(out+r*8,eval(w+r*blocks,a,blocks));
+}
+Q4_0ArgmaxResult lut_q4_argmax(const LutQ4Block*w,const LutQ8Block*a,const int*counts,float penalty,std::size_t offset,std::size_t rows,std::size_t blocks) noexcept {
+ Q4_0ArgmaxResult best{-std::numeric_limits<float>::infinity(),offset};
+ alignas(32) float values[8];
+ for(std::size_t r=0;r<rows/8;++r) {
+  _mm256_store_ps(values,eval(w+r*blocks,a,blocks));
+  for(std::size_t lane=0;lane<8;++lane) {
+   std::size_t index=offset+r*8+lane;float v=values[lane];
+   if(counts&&counts[index]>0&&penalty>1)v=v>0?v/penalty:v*penalty;
+   if(v>best.value)best={v,index};
+  }
+ }
+ return best;
+}
+}
